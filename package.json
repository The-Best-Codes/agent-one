{
  "name": "agent-one",
  "private": true,
  "version": "0.0.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit",
    "format": "npm run format:main && npm run format:rust",
    "format:check": "npm run format:check:main && npm run format:check:rust",
    "format:main": "prettier --write .",
    "format:check:main": "prettier --check .",
    "format:rust": "cd src-tauri && cargo fmt && cd ..",
    "format:check:rust": "cd src-tauri && cargo fmt --check && cd ..",
    "react-scan": "react-scan localhost:1420",
    "test:unit-test": "vitest run",
    "test:unit-test:ui": "vitest run --ui",
    "test:docker-down": "docker-compose -f docker/docker-compose.yml down",
    "test-local:e2e": "playwright test",
    "test-local:e2e:headed": "playwright test --headed",
    "test-local:e2e:report": "playwright show-report",
    "test:e2e": "./scripts/docker-test-runner.sh npm run test-local:e2e",
    "test:e2e:report": "playwright show-report ./docker/cached/playwright-report"
  },
