    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate-icons": "tauri icon public/icon-dark-wide-padding.svg",
    "lint": "eslint src --cache",
    "typecheck": "tsc -b --incremental --noEmit",
    "fmt": "oxfmt --write . && cd src-tauri && cargo fmt",
    "fmt:check": "oxfmt --check . && cd src-tauri && cargo fmt --check",
    "spellcheck": "cspell --gitignore .",
    "test:unit-test": "vitest run",
    "test:unit-test:ui": "vitest run --ui",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "update:model-list": "bun scripts/update-model-directory.js",
    "update:mcp-registry": "bun scripts/update-mcp-registry.js && bunx quicktype -l ts --just-types --prefer-types --prefer-unions --no-enums -t McpRegistryEntry -o src/assets/mcp-registry/types.ts src/assets/mcp-registry/mcp-registry.json && bun run fmt"
  },
