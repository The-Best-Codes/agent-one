{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOne",
  "version": "0.0.17",
  "identifier": "dev.agent-one",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOne",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agent-one"]
      }
    },
    "sql": {
      "preload": ["sqlite:agent-one.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRUVCQzlBMERBRjY2Q0EKUldUS1pxOE5tcnp1YXdxemNiYURnRHIxZElsNkxEenJHQWFZZ3JENDkvWUZKZ0dZaE5IS2hhRFQK",
      "endpoints": [
        "https://github.com/AgentOne-Dev/agent-one-public/releases/latest/download/latest.json"
      ]
    }
  }
}
