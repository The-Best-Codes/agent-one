{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOne",
  "version": "0.1.0",
  "identifier": "com.agent-one",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOne",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": ["binaries/fnm"],
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NEM2NDU1MDg1MUQxRjQKUldUMDBWRUlWV1JNdGpYYjVrQVNjaDRreEIzUHgvakZ4Yi80NW5mNnlsSm5LQW0wa1hFTnhSUjQK",
      "endpoints": [
        "https://github.com/The-Best-Codes/agent-one/releases/latest/download/latest.json"
      ]
    }
  }
}
