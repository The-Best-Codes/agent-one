{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "opener:default",
    "sql:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "npx",
          "cmd": "npx",
          "args": true
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true
        },
        {
          "name": "node",
          "cmd": "node",
          "args": true
        },
        {
          "name": "npx.cmd",
          "cmd": "npx.cmd",
          "args": true
        },
        {
          "name": "npm.cmd",
          "cmd": "npm.cmd",
          "args": true
        },
        {
          "name": "node.cmd",
          "cmd": "node.cmd",
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "fs:default",
    "dialog:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-html",
    "log:default",
    "notification:default",
    "process:default",
    "deep-link:default",
    "os:default",
    "http:default"
  ]
}
