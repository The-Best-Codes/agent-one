{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "opener:default",
    "sql:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/fnm",
          "args": true,
          "sidecar": true
        },
        {
          "name": "npx",
          "cmd": "npx",
          "args": true
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true
        }
      ]
    },
    "fs:default"
  ]
}
