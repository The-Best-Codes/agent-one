{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "a1-instance-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "shell:default",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "fs:default",
    "fs:write-all",
    "fs:read-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "**/.*" }, { "path": "**/.*/**" }]
    },
    "dialog:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-html",
    "log:default",
    "notification:default",
    "process:default",
    "deep-link:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*:*"
        }
      ]
    },
    "websocket:default"
  ]
}
