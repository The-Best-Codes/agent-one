{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "disabled": true
    },
    "rust": {
      "disabled": true
    }
  },
  "provider": {
    "openrouter-new": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentOne Development",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "google/gemini-3.1-flash-lite-preview": {
          "name": "Gemini 3.1 Flash Lite Preview",
          "cost": {
            "input": 0.25,
            "output": 1.5
          },
          "limit": {
            "context": 1000000,
            "output": 65000
          }
        }
      }
    }
  }
}
