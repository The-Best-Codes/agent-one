{
  "lsp": {
    "typescript": {
      "disabled": true
    },
    "rust": {
      "disabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.inkeep.com/better-auth/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
